{
  "expo": {
    "name": "Lift",
    "slug": "lift",
    "version": "0.22.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onddrej.lift"
    },
    "android": {
      "package": "com.onddrej.lift",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101012",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest_complete.wav"
          ]
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can photograph an exercise or machine.",
          "photosPermission": "Allow $(PRODUCT_NAME) to open your library so you can choose a photo for an exercise.",
          "colors": {
            "cropToolbarColor": "#F4F4F6",
            "cropToolbarIconColor": "#111114",
            "cropToolbarActionTextColor": "#54700A",
            "cropBackButtonIconColor": "#111114",
            "cropBackgroundColor": "#F4F4F6"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000",
              "cropToolbarIconColor": "#F5F7F8",
              "cropToolbarActionTextColor": "#D2F34B",
              "cropBackButtonIconColor": "#F5F7F8",
              "cropBackgroundColor": "#000000"
            }
          }
        }
      ],
      "./plugins/with-theme-launcher-icons.ts",
      "./plugins/with-exact-alarms.ts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a625a40-8cba-4aa3-ac08-9ae4dd880d8e"
      }
    },
    "owner": "pawant67"
  }
}
